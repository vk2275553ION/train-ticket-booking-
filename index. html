<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Southern Rail Express - Railway Ticket Booking & C++ Mini Project</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
        }
        .mono-font {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #e2e8f0;
        }
        ::-webkit-scrollbar-thumb {
            background: #64748b;
            border-radius: 4px;
        }
        .seat-btn {
            transition: all 0.15s ease-in-out;
        }
        .seat-btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }
        @keyframes pulse-subtle {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .live-dot {
            animation: pulse-subtle 2s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col text-slate-800">

    <!-- Top Navigation Bar -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-50 border-b border-slate-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between py-3 gap-3">
                <!-- Brand Logo -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="bg-emerald-500 text-slate-950 p-2.5 rounded-xl shadow-md">
                            <i class="fa-solid fa-train-subway text-2xl"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h1 class="text-xl font-extrabold tracking-tight text-white">RailConnect <span class="text-emerald-400">Pro</span></h1>
                                <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs px-2 py-0.5 rounded-full font-semibold">C/C++ Mini Project</span>
                            </div>
                            <p class="text-xs text-slate-400">Southern Railway Reservation System & Cloud Sheet Sync</p>
                        </div>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="flex flex-wrap items-center gap-1.5 bg-slate-800 p-1.5 rounded-xl border border-slate-700">
                    <button onclick="switchTab('booking')" id="tab-booking" class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-semibold bg-emerald-500 text-slate-950 shadow-sm transition-all">
                        <i class="fa-solid fa-ticket"></i>
                        <span>Book Ticket</span>
                    </button>
                    <button onclick="switchTab('pnr')" id="tab-pnr" class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-700/60 transition-all">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>PNR & Bookings</span>
                        <span id="booking-count-badge" class="bg-slate-700 text-emerald-400 text-xs px-1.5 py-0.5 rounded-full font-bold">2</span>
                    </button>
                    <button onclick="switchTab('cpp')" id="tab-cpp" class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-700/60 transition-all">
                        <i class="fa-solid fa-code"></i>
                        <span>C++ Source Code</span>
                    </button>
                    <button onclick="switchTab('gsheet')" id="tab-gsheet" class="tab-btn flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-700/60 transition-all">
                        <i class="fa-solid fa-table"></i>
                        <span>Google Sheet (தமிழ்)</span>
                    </button>
                </nav>
            </div>
        </div>
    </header>

    <!-- Custom Notification Banner -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ==================== TAB 1: BOOK TICKET ==================== -->
        <section id="section-booking" class="space-y-6">
            <!-- Hero Search Banner -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-emerald-950 rounded-2xl p-6 text-white shadow-xl border border-slate-700 relative overflow-hidden">
                <div class="relative z-10">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                        <div>
                            <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-700/60 px-3 py-1 rounded-full mb-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
                                Struct & File I/O Simulation Active
                            </span>
                            <h2 class="text-2xl sm:text-3xl font-extrabold">Search & Reserve Train Tickets</h2>
                            <p class="text-slate-300 text-sm mt-1">Instant seat allocation with PNR generation & optional Google Sheets database sync.</p>
                        </div>
                        <div class="bg-slate-800/90 border border-slate-600 rounded-xl p-3 text-xs space-y-1 shrink-0">
                            <div class="text-slate-400 font-medium">C++ Data Structure Used:</div>
                            <div class="mono-font text-emerald-400 font-semibold">struct Ticket { int pnr; char name[50]; ... }</div>
                            <div class="flex items-center gap-2 text-slate-300 pt-1">
                                <i class="fa-solid fa-database text-emerald-400"></i>
                                <span id="gsheet-status-indicator">Local Storage + Ready for Google Sheet</span>
                            </div>
                        </div>
                    </div>

                    <!-- Search Filter Form -->
                    <form id="search-form" onsubmit="filterTrains(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 bg-white/10 backdrop-blur-md p-4 rounded-xl border border-white/15">
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">From Station</label>
                            <div class="relative">
                                <i class="fa-solid fa-location-dot absolute left-3 top-3 text-emerald-400"></i>
                                <select id="from-station" class="w-full pl-9 pr-3 py-2 bg-slate-900/90 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-400">
                                    <option value="ALL">All Origins (அனைத்தும்)</option>
                                    <option value="MAS" selected>Chennai Central (MAS)</option>
                                    <option value="MS">Chennai Egmore (MS)</option>
                                    <option value="CBE">Coimbatore Jn (CBE)</option>
                                    <option value="MDU">Madurai Jn (MDU)</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">To Station</label>
                            <div class="relative">
                                <i class="fa-solid fa-flag-checkered absolute left-3 top-3 text-emerald-400"></i>
                                <select id="to-station" class="w-full pl-9 pr-3 py-2 bg-slate-900/90 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-400">
                                    <option value="ALL" selected>All Destinations (அனைத்தும்)</option>
                                    <option value="CBE">Coimbatore Jn (CBE)</option>
                                    <option value="MDU">Madurai Jn (MDU)</option>
                                    <option value="TPJ">Tiruchirappalli (TPJ)</option>
                                    <option value="MAS">Chennai Central (MAS)</option>
                                    <option value="CAPE">Kanyakumari (CAPE)</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Journey Date</label>
                            <input type="date" id="journey-date" required class="w-full px-3 py-2 bg-slate-900/90 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-400">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Coach Class</label>
                            <select id="travel-class" onchange="updateFareCalculation()" class="w-full px-3 py-2 bg-slate-900/90 border border-slate-600 rounded-lg text-sm text-white focus:outline-none focus:border-emerald-400">
                                <option value="SL" data-multiplier="1">Sleeper (SL) - Base Fare</option>
                                <option value="3A" data-multiplier="2.4">AC 3 Tier (3A) - 2.4x</option>
                                <option value="2A" data-multiplier="3.5">AC 2 Tier (2A) - 3.5x</option>
                                <option value="CC" data-multiplier="1.8">AC Chair Car (CC) - 1.8x</option>
                            </select>
                        </div>

                        <div class="flex items-end">
                            <button type="submit" class="w-full py-2.5 px-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-lg shadow-md transition flex items-center justify-center gap-2 text-sm">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <span>Find Trains</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Main Booking Grid: Left Train List & Coach Map | Right Passenger Form -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Left Column: Available Trains & Seat Map (7 Cols) -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <!-- Available Trains Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="bg-slate-50 px-5 py-3.5 border-b border-slate-200 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-list-ul text-emerald-600"></i>
                                <h3 class="font-bold text-slate-800">1. Select Your Train (ரயிலைத் தேர்ந்தெடுக்கவும்)</h3>
                            </div>
                            <button onclick="resetTrainFilter()" class="text-xs text-emerald-600 hover:underline font-semibold">Show All Trains</button>
                        </div>
                        <div id="train-list-container" class="divide-y divide-slate-100 max-h-80 overflow-y-auto">
                            <!-- Dynamically populated by JS -->
                        </div>
                    </div>

                    <!-- Interactive Coach Seat Selection -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 mb-4 border-b border-slate-200">
                            <div>
                                <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-couch text-emerald-600"></i>
                                    <span>2. Interactive Coach Map (S1 Coach - 24 Berths)</span>
                                </h3>
                                <p class="text-xs text-slate-500 mt-0.5">Click seats to select (Maximum 6 seats per PNR booking)</p>
                            </div>
                            <!-- Legend -->
                            <div class="flex items-center gap-3 text-xs font-medium">
                                <span class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-slate-100 border border-slate-300 inline-block"></span> Available</span>
                                <span class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-emerald-500 text-white inline-block"></span> Selected</span>
                                <span class="flex items-center gap-1.5"><span class="w-3.5 h-3.5 rounded bg-rose-500 text-white inline-block"></span> Booked</span>
                            </div>
                        </div>

                        <!-- Coach Layout Container -->
                        <div class="bg-slate-50 border-2 border-slate-300 rounded-xl p-4">
                            <div class="flex justify-between items-center text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 px-1">
                                <span><i class="fa-solid fa-door-open mr-1"></i> Entry Door</span>
                                <span id="active-coach-label" class="text-slate-600">Train #12675 - Kovai Express</span>
                                <span>Washroom <i class="fa-solid fa-restroom ml-1"></i></span>
                            </div>

                            <!-- 24 Seats Grid -->
                            <div id="seat-grid" class="grid grid-cols-4 sm:grid-cols-6 gap-2.5">
                                <!-- Generated by JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Passenger Booking Form (5 Cols) -->
                <div class="lg:col-span-5">
                    <div class="bg-white rounded-2xl shadow-md border border-slate-200 overflow-hidden sticky top-20">
                        <div class="bg-slate-900 text-white px-5 py-4 flex items-center justify-between">
                            <div>
                                <h3 class="font-bold text-base flex items-center gap-2">
                                    <i class="fa-solid fa-file-signature text-emerald-400"></i>
                                    <span>3. Passenger Reservation Form</span>
                                </h3>
                                <p class="text-xs text-slate-400">Saves to Local Storage & Google Sheet (if linked)</p>
                            </div>
                            <span class="mono-font text-xs bg-emerald-500/20 text-emerald-300 px-2.5 py-1 rounded border border-emerald-500/30">bookTicket()</span>
                        </div>

                        <form id="booking-form" onsubmit="handleTicketSubmit(event)" class="p-5 space-y-4">
                            <!-- Selected Train Summary Box -->
                            <div class="bg-emerald-50/80 border border-emerald-200 rounded-xl p-3.5 text-sm">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span id="summary-train-no" class="text-xs font-bold bg-emerald-600 text-white px-2 py-0.5 rounded">#12675</span>
                                        <h4 id="summary-train-name" class="font-bold text-slate-800 mt-1">Kovai Superfast Express</h4>
                                        <p id="summary-train-route" class="text-xs text-slate-600">Chennai Central (06:10) → Coimbatore Jn (14:05)</p>
                                    </div>
                                    <div class="text-right">
                                        <span class="text-xs text-slate-500 block">Selected Seats</span>
                                        <span id="summary-seats-badge" class="font-extrabold text-emerald-700 mono-font">None</span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Passenger Full Name (பெயர்) *</label>
                                    <input type="text" id="passenger-name" required placeholder="e.g. Karthik Raja" class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Age (வயது) *</label>
                                    <input type="number" id="passenger-age" required min="1" max="115" placeholder="21" class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Gender (பாலினம்) *</label>
                                    <select id="passenger-gender" class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                        <option value="Male">Male (ஆண்)</option>
                                        <option value="Female">Female (பெண்)</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mobile Number *</label>
                                    <input type="tel" id="passenger-phone" required pattern="[0-9]{10}" placeholder="9876543210" class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Berth Preference</label>
                                    <select id="berth-pref" class="w-full px-3.5 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                        <option value="No Preference">Auto / Selected Seat</option>
                                        <option value="Lower">Lower Berth (LB)</option>
                                        <option value="Middle">Middle Berth (MB)</option>
                                        <option value="Upper">Upper Berth (UB)</option>
                                        <option value="Side Lower">Side Lower (SL)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Price Breakdown -->
                            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-1.5 text-sm">
                                <div class="flex justify-between text-slate-600">
                                    <span>Ticket Fare (<span id="fare-seat-count">1</span> Seat × ₹<span id="fare-per-seat">285</span>):</span>
                                    <span class="font-semibold">₹<span id="fare-base-total">285</span></span>
                                </div>
                                <div class="flex justify-between text-slate-500 text-xs">
                                    <span>IRCTC Convenience & GST:</span>
                                    <span>₹35</span>
                                </div>
                                <div class="border-t border-slate-200 pt-2 flex justify-between items-center text-base font-extrabold text-slate-900">
                                    <span>Total Payable Amount:</span>
                                    <span class="text-emerald-600 text-lg">₹<span id="fare-grand-total">320</span></span>
                                </div>
                            </div>

                            <button type="submit" id="submit-booking-btn" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg hover:shadow-emerald-500/25 transition flex items-center justify-center gap-2 text-base">
                                <i class="fa-solid fa-check-circle"></i>
                                <span>Confirm & Generate PNR Ticket</span>
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==================== TAB 2: PNR STATUS & BOOKED TICKETS ==================== -->
        <section id="section-pnr" class="hidden space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-200">
                    <div>
                        <h2 class="text-2xl font-extrabold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-emerald-600"></i>
                            <span>PNR Status Enquiry & Reservation Chart</span>
                        </h2>
                        <p class="text-sm text-slate-500">Equivalent to C++ <code class="mono-font bg-slate-100 px-1.5 py-0.5 rounded text-slate-700">searchByPNR()</code> and <code class="mono-font bg-slate-100 px-1.5 py-0.5 rounded text-slate-700">cancelTicket()</code> functions.</p>
                    </div>

                    <!-- Search Box -->
                    <div class="flex items-center gap-2">
                        <div class="relative">
                            <i class="fa-solid fa-hashtag absolute left-3 top-3 text-slate-400"></i>
                            <input type="text" id="pnr-search-input" oninput="renderBookedTickets()" placeholder="Enter 10-digit PNR or Name..." class="pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none w-64">
                        </div>
                        <button onclick="exportTicketsCSV()" class="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 transition">
                            <i class="fa-solid fa-file-csv text-emerald-400"></i>
                            <span>Export CSV</span>
                        </button>
                    </div>
                </div>

                <!-- Tickets List -->
                <div id="booked-tickets-container" class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6">
                    <!-- Populated by JS -->
                </div>
            </div>
        </section>

        <!-- ==================== TAB 3: C & C++ MINI PROJECT SOURCE CODE ==================== -->
        <section id="section-cpp" class="hidden space-y-6">
            <div class="bg-slate-900 text-white rounded-2xl shadow-xl border border-slate-700 overflow-hidden">
                <div class="p-6 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950 border border-emerald-700 px-2.5 py-1 rounded-full">Ready for Code::Blocks / Turbo C++ / VS Code / GCC</span>
                        <h2 class="text-2xl font-extrabold mt-2">Complete C++ Mini Project Source Code (<code class="mono-font text-emerald-400">railway_reservation.cpp</code>)</h2>
                        <p class="text-sm text-slate-400 mt-1">Uses <code class="text-slate-200">class</code>, <code class="text-slate-200">struct</code>, File Handling (<code class="text-slate-200">fstream</code>), and exports bookings to <code class="text-emerald-300">tickets_db.csv</code> which opens directly in Google Sheets or Excel!</p>
                    </div>
                    <button onclick="copyCode('cpp-source-code')" class="shrink-0 px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl shadow transition flex items-center gap-2 text-sm">
                        <i class="fa-regular fa-copy"></i>
                        <span>Copy C++ Code</span>
                    </button>
                </div>

                <!-- Viva / Project Synopsis Points -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 p-6 bg-slate-800/60 border-b border-slate-800 text-xs">
                    <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-700">
                        <div class="font-bold text-emerald-400 mb-1"><i class="fa-solid fa-cubes mr-1"></i> OOP Concepts Used</div>
                        <p class="text-slate-300">Classes & Objects, Encapsulation, Constructors, Member Functions, and Struct records.</p>
                    </div>
                    <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-700">
                        <div class="font-bold text-emerald-400 mb-1"><i class="fa-solid fa-file-csv mr-1"></i> File Handling & Sheet Sync</div>
                        <p class="text-slate-300">Saves every ticket into <code class="mono-font text-amber-300">tickets_db.csv</code> so you can upload or sync with Google Sheets.</p>
                    </div>
                    <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-700">
                        <div class="font-bold text-emerald-400 mb-1"><i class="fa-solid fa-list-check mr-1"></i> 5 Menu Modules</div>
                        <p class="text-slate-300">1. View Trains 2. Book Ticket 3. Check PNR Status 4. Cancel Ticket 5. View All Bookings.</p>
                    </div>
                    <div class="bg-slate-900/90 p-3.5 rounded-xl border border-slate-700">
                        <div class="font-bold text-emerald-400 mb-1"><i class="fa-solid fa-terminal mr-1"></i> How to Run</div>
                        <p class="text-slate-300">Compile using <code class="mono-font text-amber-300">g++ railway.cpp -o railway</code> and run <code class="mono-font text-amber-300">./railway</code>.</p>
                    </div>
                </div>

                <!-- Code Block -->
                <div class="p-6 overflow-x-auto bg-slate-950">
