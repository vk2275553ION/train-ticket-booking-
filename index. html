#include &lt;iostream&gt;
#include &lt;fstream&gt;
#include &lt;string&gt;
#include &lt;iomanip&gt;
#include &lt;vector&gt;
#include &lt;ctime&gt;

using namespace std;

// Structure to store Train Details
struct Train {
    int trainNo;
    string trainName;
    string source;
    string destination;
    string departureTime;
    int fare;
    int availableSeats;
};

// Class to handle Passenger Ticket Operations
class RailwaySystem {
private:
    vector&lt;Train&gt; trains;
    const string csvFileName = "tickets_db.csv";

public:
    RailwaySystem() {
        // Initialize Southern Railway Trains
        trains.push_back({12675, "Kovai SF Express", "Chennai(MAS)", "Coimbatore(CBE)", "06:10 AM", 285, 24});
        trains.push_back({12637, "Pandian SF Express", "Chennai(MS)", "Madurai(MDU)", "09:40 PM", 340, 24});
        trains.push_back({12635, "Vaigai SF Express", "Chennai(MS)", "Madurai(MDU)", "01:50 PM", 260, 24});
        trains.push_back({12673, "Cheran SF Express", "Chennai(MAS)", "Coimbatore(CBE)", "10:10 PM", 320, 24});
        trains.push_back({12633, "Kanyakumari Exp", "Chennai(MS)", "Kanyakumari(CAPE)", "05:20 PM", 435, 24});

        // Create CSV header if file does not exist (Compatible with Google Sheets)
        ifstream checkFile(csvFileName);
        if (!checkFile.good()) {
            ofstream outFile(csvFileName);
            outFile &lt;&lt; "PNR,PassengerName,Age,Gender,Phone,TrainNo,TrainName,CoachClass,Seats,TotalFare,Status\n";
            outFile.close();
        }
        checkFile.close();
    }

    // 1. Display All Available Trains
    void displayTrains() {
        cout &lt;&lt; "\n========================================================================================\n";
        cout &lt;&lt; left &lt;&lt; setw(10) &lt;&lt; "Train No" &lt;&lt; setw(22) &lt;&lt; "Train Name" 
             &lt;&lt; setw(16) &lt;&lt; "From" &lt;&lt; setw(18) &lt;&lt; "To" 
             &lt;&lt; setw(12) &lt;&lt; "Dep Time" &lt;&lt; setw(8) &lt;&lt; "Fare" &lt;&lt; "Seats\n";
        cout &lt;&lt; "========================================================================================\n";
        for (const auto &amp;t : trains) {
            cout &lt;&lt; left &lt;&lt; setw(10) &lt;&lt; t.trainNo &lt;&lt; setw(22) &lt;&lt; t.trainName
                 &lt;&lt; setw(16) &lt;&lt; t.source &lt;&lt; setw(18) &lt;&lt; t.destination
                 &lt;&lt; setw(12) &lt;&lt; t.departureTime &lt;&lt; "Rs." &lt;&lt; setw(5) &lt;&lt; t.fare 
                 &lt;&lt; t.availableSeats &lt;&lt; "\n";
        }
        cout &lt;&lt; "========================================================================================\n";
    }

    // 2. Book a Ticket and Save to CSV File
    void bookTicket() {
        displayTrains();
        int tNo, age, numSeats;
        string name, gender, phone, coachClass;

        cout &lt;&lt; "\nEnter Train Number to Book: ";
        cin &gt;&gt; tNo;

        int idx = -1;
        for (size_t i = 0; i &lt; trains.size(); i++) {
            if (trains[i].trainNo == tNo) {
                idx = i;
                break;
            }
        }

        if (idx == -1) {
            cout &lt;&lt; "\n[ERROR] Invalid Train Number! Please try again.\n";
            return;
        }

        cout &lt;&lt; "Enter Passenger Full Name: ";
        cin.ignore();
        getline(cin, name);
        cout &lt;&lt; "Enter Age: ";
        cin &gt;&gt; age;
        cout &lt;&lt; "Enter Gender (Male/Female): ";
        cin &gt;&gt; gender;
        cout &lt;&lt; "Enter 10-Digit Mobile Number: ";
        cin &gt;&gt; phone;
        cout &lt;&lt; "Enter Coach Class (SL / 3A / 2A): ";
        cin &gt;&gt; coachClass;
        cout &lt;&lt; "Enter Number of Seats (1-6): ";
        cin &gt;&gt; numSeats;

        if (numSeats &lt;= 0 || numSeats &gt; trains[idx].availableSeats) {
            cout &lt;&lt; "\n[ERROR] Requested seats not available!\n";
            return;
        }

        // Generate unique PNR number
        srand(time(0));
        long pnr = 4200000000 + (rand() % 90000000 + 10000000);
        int totalFare = (trains[idx].fare * numSeats) + 35; // +Rs.35 IRCTC Tax
        trains[idx].availableSeats -= numSeats;

        // Save to CSV file (Can be imported directly to Google Sheets)
        ofstream file(csvFileName, ios::app);
        file &lt;&lt; pnr &lt;&lt; "," &lt;&lt; name &lt;&lt; "," &lt;&lt; age &lt;&lt; "," &lt;&lt; gender &lt;&lt; "," 
             &lt;&lt; phone &lt;&lt; "," &lt;&lt; trains[idx].trainNo &lt;&lt; "," &lt;&lt; trains[idx].trainName &lt;&lt; "," 
             &lt;&lt; coachClass &lt;&lt; ",S1-" &lt;&lt; numSeats &lt;&lt; "Seats," &lt;&lt; totalFare &lt;&lt; ",CONFIRMED\n";
        file.close();

        cout &lt;&lt; "\n+-------------------------------------------------------+\n";
        cout &lt;&lt; "|           TICKET BOOKED SUCCESSFULLY (CNF)            |\n";
        cout &lt;&lt; "+-------------------------------------------------------+\n";
        cout &lt;&lt; "  PNR Number     : " &lt;&lt; pnr &lt;&lt; "\n";
        cout &lt;&lt; "  Passenger Name : " &lt;&lt; name &lt;&lt; " (" &lt;&lt; age &lt;&lt; "/" &lt;&lt; gender &lt;&lt; ")\n";
        cout &lt;&lt; "  Train          : " &lt;&lt; trains[idx].trainNo &lt;&lt; " - " &lt;&lt; trains[idx].trainName &lt;&lt; "\n";
        cout &lt;&lt; "  Route          : " &lt;&lt; trains[idx].source &lt;&lt; " to " &lt;&lt; trains[idx].destination &lt;&lt; "\n";
        cout &lt;&lt; "  Total Paid     : Rs. " &lt;&lt; totalFare &lt;&lt; " (Saved to tickets_db.csv)\n";
        cout &lt;&lt; "+-------------------------------------------------------+\n";
    }

    // 3. View All Booked Tickets from File
    void viewAllBookings() {
        ifstream file(csvFileName);
        string line;
        cout &lt;&lt; "\n--- ALL SAVED RESERVATIONS (FROM CSV FILE) ---\n";
        while (getline(file, line)) {
            cout &lt;&lt; line &lt;&lt; "\n";
        }
        file.close();
    }
};

int main() {
    RailwaySystem rail;
    int choice;

    do {
        cout &lt;&lt; "\n=============================================\n";
        cout &lt;&lt; "   SOUTHERN RAILWAY RESERVATION SYSTEM (C++) \n";
        cout &lt;&lt; "=============================================\n";
        cout &lt;&lt; "  1. View Available Trains\n";
        cout &lt;&lt; "  2. Book New Train Ticket\n";
        cout &lt;&lt; "  3. View All Booked Tickets (CSV Records)\n";
        cout &lt;&lt; "  4. Exit Program\n";
        cout &lt;&lt; "---------------------------------------------\n";
        cout &lt;&lt; "Enter your choice (1-4): ";
        cin &gt;&gt; choice;

        switch (choice) {
            case 1: rail.displayTrains(); break;
            case 2: rail.bookTicket(); break;
            case 3: rail.viewAllBookings(); break;
            case 4: cout &lt;&lt; "\nThank you for using Southern Railway Reservation System!\n"; break;
            default: cout &lt;&lt; "\nInvalid choice! Please select 1-4.\n";
        }
    } while (choice != 4);

    return 0;
}</code></pre>
