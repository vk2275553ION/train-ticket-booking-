                    <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
                        <div class="text-right">
                            <span class="text-xs text-slate-400">Base SL Fare</span>
                            <span class="text-base font-extrabold text-slate-900 block">₹${train.baseFare}</span>
                        </div>
                        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                            AVL ${availCount} Seats
                        </span>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        // Select a Specific Train
        function selectTrain(trainNo) {
            const found = TRAINS_DATA.find(t => t.trainNo === trainNo);
            if (!found) return;
            selectedTrain = found;

            // Default select 1 available seat
            selectedSeats = [];
            for (let i = 1; i <= 24; i++) {
                if (!selectedTrain.bookedSeats.includes(i)) {
                    selectedSeats.push(i);
                    break;
                }
            }

            renderTrainList();
            renderCoachSeats();
            updateFareCalculation();
        }

        // Render 24-Berth Interactive Coach Map
        function renderCoachSeats() {
            const grid = document.getElementById('seat-grid');
            document.getElementById('active-coach-label').innerText = `Train #${selectedTrain.trainNo} - ${selectedTrain.name}`;
            grid.innerHTML = "";

            for (let i = 1; i <= 24; i++) {
                const berthType = BERTH_TYPES[(i - 1) % 8];
                const isBooked = selectedTrain.bookedSeats.includes(i);
                const isSelected = selectedSeats.includes(i);

                const btn = document.createElement('button');
                btn.type = "button";
                btn.disabled = isBooked;

                let colorClass = "bg-white hover:border-emerald-500 text-slate-700 border-slate-300";
                if (isBooked) {
                    colorClass = "bg-rose-500 text-white border-rose-600 opacity-75 cursor-not-allowed";
                } else if (isSelected) {
                    colorClass = "bg-emerald-500 text-white border-emerald-600 shadow-md ring-2 ring-emerald-300";
                }

                btn.className = `seat-btn border rounded-lg p-2 flex flex-col items-center justify-center text-xs font-bold ${colorClass}`;
                btn.innerHTML = `
                    <span>S1-${i}</span>
                    <span class="text-[10px] font-normal opacity-80">${berthType}</span>
                `;

                if (!isBooked) {
                    btn.onclick = () => toggleSeat(i);
                }

                grid.appendChild(btn);
            }
        }

        // Toggle Seat Selection
        function toggleSeat(seatNumber) {
            const index = selectedSeats.indexOf(seatNumber);
            if (index > -1) {
                if (selectedSeats.length === 1) {
                    showToast("At least 1 seat must be selected for booking.", "info");
                    return;
                }
                selectedSeats.splice(index, 1);
            } else {
                if (selectedSeats.length >= 6) {
                    showToast("Maximum 6 seats allowed per PNR booking!", "error");
                    return;
                }
                selectedSeats.push(seatNumber);
            }
            selectedSeats.sort((a, b) => a - b);
            renderCoachSeats();
            updateFareCalculation();
        }

        // Calculate Total Fare & Update Summary Card
        function updateFareCalculation() {
            const classSelect = document.getElementById('travel-class');
            const selectedOption = classSelect.options[classSelect.selectedIndex];
            const multiplier = parseFloat(selectedOption.getAttribute('data-multiplier') || "1");

            const seatCount = selectedSeats.length;
            const perSeatFare = Math.round(selectedTrain.baseFare * multiplier);
            const baseTotal = perSeatFare * seatCount;
            const grandTotal = seatCount > 0 ? baseTotal + 35 : 0;

            // Update Summary DOM
            document.getElementById('summary-train-no').innerText = `#${selectedTrain.trainNo}`;
            document.getElementById('summary-train-name').innerText = selectedTrain.name;
            document.getElementById('summary-train-route').innerText = `${selectedTrain.fromName} (${selectedTrain.depTime}) → ${selectedTrain.toName} (${selectedTrain.arrTime})`;

            const seatLabels = selectedSeats.map(s => `S1-${s}(${BERTH_TYPES[(s - 1) % 8]})`);
            document.getElementById('summary-seats-badge').innerText = seatLabels.length ? seatLabels.join(', ') : "None";

            document.getElementById('fare-seat-count').innerText = seatCount;
            document.getElementById('fare-per-seat').innerText = perSeatFare;
            document.getElementById('fare-base-total').innerText = baseTotal;
            document.getElementById('fare-grand-total').innerText = grandTotal;
        }

        // Handle Booking Submission (Local Storage + Optional Google Sheet Sync)
        function handleTicketSubmit(e) {
            e.preventDefault();

            if (selectedSeats.length === 0) {
                showToast("Please select at least one seat on the coach map!", "error");
                return;
            }

            const submitBtn = document.getElementById('submit-booking-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Processing PNR...</span>`;

            const pnr = "42" + Math.floor(10000000 + Math.random() * 90000000);
            const passengerName = document.getElementById('passenger-name').value.trim();
            const age = document.getElementById('passenger-age').value;
            const gender = document.getElementById('passenger-gender').value;
            const phone = document.getElementById('passenger-phone').value;
            const journeyDate = document.getElementById('journey-date').value;
            const travelClass = document.getElementById('travel-class').value;
            const seatString = selectedSeats.map(s => `S1-${s} (${BERTH_TYPES[(s - 1) % 8]})`).join(', ');
            const totalFare = parseInt(document.getElementById('fare-grand-total').innerText, 10);

            const newTicket = {
                pnr,
                passengerName,
                age,
                gender,
                phone,
                trainNo: selectedTrain.trainNo,
                trainName: selectedTrain.name,
                route: `${selectedTrain.fromName} → ${selectedTrain.toName}`,
                journeyDate,
                travelClass,
                seats: seatString,
                totalFare,
                status: "CONFIRMED"
            };

            // Mark seats as booked on current train
            selectedTrain.bookedSeats.push(...selectedSeats);

            // Save to Local Storage
            bookedTickets.unshift(newTicket);
            localStorage.setItem("rail_booked_tickets", JSON.stringify(bookedTickets));

            // Pick next available seat for next booking
            selectedSeats = [];
            for (let i = 1; i <= 24; i++) {
                if (!selectedTrain.bookedSeats.includes(i)) {
                    selectedSeats.push(i);
                    break;
                }
            }

            // Send to Google Sheet if URL is configured
            if (googleSheetUrl) {
                fetch(googleSheetUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify(newTicket)
                }).then(() => {
                    showToast(`PNR ${pnr} Booked & Saved to Google Sheet!`, "success");
                }).catch(() => {
                    showToast(`PNR ${pnr} Booked Locally (Sheet Sync Offline)`, "info");
                });
            } else {
                showToast(`Ticket Confirmed! PNR: ${pnr}`, "success");
            }

            // Reset Form & UI
            document.getElementById('booking-form').reset();
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<i class="fa-solid fa-check-circle"></i> <span>Confirm & Generate PNR Ticket</span>`;

            renderTrainList();
            renderCoachSeats();
            updateFareCalculation();
            renderBookedTickets();
        }

        // Render Booked Tickets & PNR Search
        function renderBookedTickets() {
            const container = document.getElementById('booked-tickets-container');
            const badge = document.getElementById('booking-count-badge');
            const query = (document.getElementById('pnr-search-input')?.value || "").toLowerCase().trim();

            badge.innerText = bookedTickets.length;
            container.innerHTML = "";

            const filtered = bookedTickets.filter(t => 
                t.pnr.toLowerCase().includes(query) ||
                t.passengerName.toLowerCase().includes(query) ||
                t.trainName.toLowerCase().includes(query)
            );

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-12 bg-slate-50 rounded-xl border border-dashed border-slate-300">
                        <i class="fa-solid fa-ticket-simple text-4xl text-slate-400 mb-2"></i>
                        <p class="font-bold text-slate-700">No Matching PNR Records Found</p>
                        <p class="text-xs text-slate-500 mt-1">Book a new ticket from the 'Book Ticket' tab to generate a PNR.</p>
                    </div>
                `;
                return;
            }

            filtered.forEach(ticket => {
                const isCancelled = ticket.status === "CANCELLED";
                const card = document.createElement('div');
                card.className = `rounded-xl border p-5 relative overflow-hidden transition shadow-sm ${
                    isCancelled ? 'bg-slate-100 border-slate-300 opacity-75' : 'bg-white border-slate-200 hover:border-emerald-400'
                }`;

                card.innerHTML = `
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-3">
                        <div>
                            <span class="text-[11px] font-bold uppercase text-slate-400 block">PNR Number</span>
                            <span class="mono-font text-lg font-extrabold text-slate-900 tracking-wide">${ticket.pnr}</span>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-extrabold ${
                            isCancelled ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'
                        }">
                            ${ticket.status}
                        </span>
                    </div>

                    <div class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Passenger:</span>
                            <span class="font-bold text-slate-800">${ticket.passengerName} (${ticket.age} / ${ticket.gender})</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Train:</span>
                            <span class="font-semibold text-slate-800">#${ticket.trainNo} - ${ticket.trainName}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Route & Date:</span>
                            <span class="text-slate-700 text-xs font-medium">${ticket.route} (${ticket.journeyDate})</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Coach / Berths:</span>
                            <span class="mono-font font-bold text-emerald-700">${ticket.travelClass} | ${ticket.seats}</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                        <div>
                            <span class="text-xs text-slate-400">Total Fare:</span>
                            <span class="text-base font-extrabold text-slate-900 ml-1">₹${ticket.totalFare}</span>
                        </div>
                        ${!isCancelled ? `
                            <button onclick="cancelTicket('${ticket.pnr}')" class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-semibold rounded-lg text-xs transition flex items-center gap-1">
                                <i class="fa-solid fa-ban"></i>
                                <span>Cancel Ticket</span>
                            </button>
                        ` : `<span class="text-xs text-rose-500 font-semibold">Refund Initiated</span>`}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Cancel a Ticket by PNR
        function cancelTicket(pnr) {
            const ticket = bookedTickets.find(t => t.pnr === pnr);
            if (ticket) {
                ticket.status = "CANCELLED";
                localStorage.setItem("rail_booked_tickets", JSON.stringify(bookedTickets));
                renderBookedTickets();
                showToast(`PNR ${pnr} has been cancelled.`, "info");
            }
        }

        // Export Booked Tickets to CSV (Matches C++ File Format)
        function exportTicketsCSV() {
            const headers = ["PNR,PassengerName,Age,Gender,Phone,TrainNo,TrainName,CoachClass,Seats,TotalFare,Status"];
            const rows = bookedTickets.map(t => 
                `${t.pnr},"${t.passengerName}",${t.age},${t.gender},${t.phone},${t.trainNo},"${t.trainName}",${t.travelClass},"${t.seats}",${t.totalFare},${t.status}`
            );
            const csvContent = "data:text/csv;charset=utf-8," + headers.concat(rows).join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "tickets_db.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("Downloaded tickets_db.csv (Ready for Excel / Google Sheets)", "success");
        }

        // Save Google Sheet URL
        function saveGoogleSheetUrl() {
            const input = document.getElementById('gsheet-webhook-url').value.trim();
            googleSheetUrl = input;
            localStorage.setItem("rail_gsheet_url", googleSheetUrl);
            if (googleSheetUrl) {
                document.getElementById('gsheet-status-indicator').innerText = "Connected to Google Sheet Live!";
                showToast("Google Sheet Web App URL Connected Successfully!", "success");
            } else {
                document.getElementById('gsheet-status-indicator').innerText = "Local Storage + Ready for Google Sheet";
                showToast("Google Sheet URL cleared. Using Local Storage.", "info");
            }
        }

        // Copy Code Helper
        function copyCode(elementId) {
            const text = document.getElementById(elementId).innerText;
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast("Code copied to clipboard!", "success");
        }

        // Custom Toast Notification (No alert() used)
        function showToast(message, type = "success") {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = {
                success: "bg-slate-900 border-emerald-500 text-white",
                error: "bg-rose-950 border-rose-500 text-white",
                info: "bg-slate-800 border-amber-400 text-white"
            };
            const icons = {
                success: "fa-circle-check text-emerald-400",
                error: "fa-triangle-exclamation text-rose-400",
                info: "fa-circle-info text-amber-400"
            };

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl border-l-4 text-sm font-medium transition-all duration-300 ${colors[type]}`;
            toast.innerHTML = `
                <i class="fa-solid ${icons[type]} text-lg"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
</body>
</html>
